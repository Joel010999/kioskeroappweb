# Plantilla de variables para el entorno STAGING en el proyecto oficial de Railway.
# REGLA CRITICA: NUNCA copiar DATABASE_URL, AUTH_SESSION_SECRET ni claves de WhatsApp desde producción.

# Base PostgreSQL AISLADA exclusivamente para staging (ej. servicio Postgres de staging en Railway).
DATABASE_URL=postgresql://postgres:CHANGE_ME@staging-host.railway.internal:5432/railway
# Para ejecución remota desde CLI local al inicializar la DB pública de staging:
STAGING_DATABASE_URL=postgresql://postgres:CHANGE_ME@staging-proxy.proxy.rlwy.net:12345/railway
POSTGRES_SSL=true

# Confirmación explícita obligatoria para scripts/staging/init-staging.mjs
STAGING_CONFIRM_ISOLATED=true
# Contraseña ficticia exclusiva para usuarios QA en staging (nunca usar contraseñas reales)
STAGING_TEST_PASSWORD=StagingQA!2026

# Secreto HMAC SHA-256 exclusivo de staging (generar nuevo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SESSION_SECRET=REPLACE_WITH_FRESH_64_HEX_STAGING_SECRET

# Nunca habilitar development-session en Railway
ALLOW_DEVELOPMENT_SESSION=false

# Scope organizacional por defecto. Dejar DASHBOARD_SOURCE_ID y DASHBOARD_BRANCH_ID vacíos para resolver por sucursal desde tabla `sources`.
DASHBOARD_ORGANIZATION_ID=1
DASHBOARD_SOURCE_ID=
DASHBOARD_BRANCH_ID=

# Ventana de frescura para pruebas (opcional)
FRESHNESS_WARNING_MINUTES=60
FRESHNESS_ERROR_MINUTES=240
POS_FRESHNESS_MAX_HOURS=24

# WhatsApp Bot DESVINCULADO en staging (NO crear ni encender worker con número real de Mónica)
# Generar una clave dummy nueva de 64 hex SOLO si se prueba cifrado en DB, nunca la de producción.
WHATSAPP_SESSION_ENCRYPTION_KEY=REPLACE_WITH_FRESH_64_HEX_STAGING_ONLY_KEY
# OBLIGATORIO VACÍO en staging:
WHATSAPP_PAIRING_NUMBER=
# Sólo números ficticios de prueba (nunca el número de Mónica ni empleados reales):
WHATSAPP_ALLOWED_NUMBERS=+5490000000001
LOG_LEVEL=info

