# Server-side only. Never use a NEXT_PUBLIC_ prefix for database configuration.
DATABASE_URL=postgresql://user:password@host:port/database
POSTGRES_SSL=true

# Auth session secret (HMAC SHA-256 for browser web sessions)
AUTH_SESSION_SECRET=

# Optional defaults used when API callers omit source_id or branch_id.
DASHBOARD_ORGANIZATION_ID=1
DASHBOARD_SOURCE_ID=
DASHBOARD_BRANCH_ID=

# Optional freshness policy in minutes. Leave empty until the business defines an SLA.
FRESHNESS_WARNING_MINUTES=
FRESHNESS_ERROR_MINUTES=

# WhatsApp Cloud API (Meta Graph API) Integration
# The phone number ID from Meta Developers WhatsApp product configuration
WHATSAPP_PHONE_NUMBER_ID=

# Permanent System User Access Token with whatsapp_business_messaging permission
WHATSAPP_ACCESS_TOKEN=

# Secret token chosen by you to verify the webhook handshake with Meta
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Meta App Secret from App Settings > Basic, used to verify X-Hub-Signature-256
WHATSAPP_APP_SECRET=

# Comma-separated list of authorized phone numbers in E.164 format (e.g. +5491112345678, 5491187654321)
WHATSAPP_ALLOWED_NUMBERS=
