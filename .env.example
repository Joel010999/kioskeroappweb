# Server-side only. Never use a NEXT_PUBLIC_ prefix for database configuration.
DATABASE_URL=postgresql://user:password@host:port/database
POSTGRES_SSL=true

# Auth session secret (HMAC SHA-256 for browser web sessions)
AUTH_SESSION_SECRET=

# Optional defaults used when API callers omit source_id or branch_id.
DASHBOARD_ORGANIZATION_ID=1
DASHBOARD_SOURCE_ID=
DASHBOARD_BRANCH_ID=

# Optional freshness policy in minutes. Leave empty until the business defines an SLA.
FRESHNESS_WARNING_MINUTES=
FRESHNESS_ERROR_MINUTES=

# WhatsApp Bot Integration (Baileys Dedicated Worker)
# Clave independiente para cifrado autenticado AES-256-GCM de credenciales y llaves Signal en PostgreSQL (mínimo 32 bytes / 64 caracteres hex)
WHATSAPP_SESSION_ENCRYPTION_KEY=

# Número de teléfono del bot para vinculación mediante código de 8 dígitos (ej: 5491112345678)
WHATSAPP_PAIRING_NUMBER=

# Lista de números autorizados separados por coma (ej: +5491112345678, 5491187654321).
# Remitentes no autorizados reciben rechazo cortés y no pueden consultar stock, pedidos ni datos de negocio.
WHATSAPP_ALLOWED_NUMBERS=

# Nivel de detalle de logs para el worker (info, warn, error)
LOG_LEVEL=info
